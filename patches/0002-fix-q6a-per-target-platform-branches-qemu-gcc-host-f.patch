diff --git a/board/recalbox/patches/qemu/0001-linux-user-rename-sched_attr.patch b/board/recalbox/patches/qemu/0001-linux-user-rename-sched_attr.patch
new file mode 100644
index 0000000..02ea90e
--- /dev/null
+++ b/board/recalbox/patches/qemu/0001-linux-user-rename-sched_attr.patch
@@ -0,0 +1,53 @@
+linux-user: rename local struct sched_attr (glibc >= 2.41 now defines it)
+
+--- a/linux-user/syscall.c	2026-10-10 13:54:47.981433089 -0300
++++ b/linux-user/syscall.c	2026-10-10 13:54:47.986435794 -0300
+@@ -359,7 +359,7 @@
+ _syscall3(int, sys_sched_setaffinity, pid_t, pid, unsigned int, len,
+           unsigned long *, user_mask_ptr);
+ /* sched_attr is not defined in glibc */
+-struct sched_attr {
++struct qemu_sched_attr {
+     uint32_t size;
+     uint32_t sched_policy;
+     uint64_t sched_flags;
+@@ -372,10 +372,10 @@
+     uint32_t sched_util_max;
+ };
+ #define __NR_sys_sched_getattr __NR_sched_getattr
+-_syscall4(int, sys_sched_getattr, pid_t, pid, struct sched_attr *, attr,
++_syscall4(int, sys_sched_getattr, pid_t, pid, struct qemu_sched_attr *, attr,
+           unsigned int, size, unsigned int, flags);
+ #define __NR_sys_sched_setattr __NR_sched_setattr
+-_syscall3(int, sys_sched_setattr, pid_t, pid, struct sched_attr *, attr,
++_syscall3(int, sys_sched_setattr, pid_t, pid, struct qemu_sched_attr *, attr,
+           unsigned int, flags);
+ #define __NR_sys_sched_getscheduler __NR_sched_getscheduler
+ _syscall1(int, sys_sched_getscheduler, pid_t, pid);
+@@ -11380,7 +11380,7 @@
+     case TARGET_NR_sched_getattr:
+         {
+             struct target_sched_attr *target_scha;
+-            struct sched_attr scha;
++            struct qemu_sched_attr scha;
+             if (arg2 == 0) {
+                 return -TARGET_EINVAL;
+             }
+@@ -11401,7 +11401,7 @@
+                 target_scha->sched_runtime = tswap64(scha.sched_runtime);
+                 target_scha->sched_deadline = tswap64(scha.sched_deadline);
+                 target_scha->sched_period = tswap64(scha.sched_period);
+-                if (scha.size > offsetof(struct sched_attr, sched_util_min)) {
++                if (scha.size > offsetof(struct qemu_sched_attr, sched_util_min)) {
+                     target_scha->sched_util_min = tswap32(scha.sched_util_min);
+                     target_scha->sched_util_max = tswap32(scha.sched_util_max);
+                 }
+@@ -11412,7 +11412,7 @@
+     case TARGET_NR_sched_setattr:
+         {
+             struct target_sched_attr *target_scha;
+-            struct sched_attr scha;
++            struct qemu_sched_attr scha;
+             uint32_t size;
+             int zeroed;
+             if (arg2 == 0) {
