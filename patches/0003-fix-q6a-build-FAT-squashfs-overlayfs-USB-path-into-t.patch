From f0698d5e6b4aa1662424f210390816e3d1d883b5 Mon Sep 17 00:00:00 2001
From: Rafael WMS <rafael.wms@live.com>
Date: Sat, 10 Oct 2026 16:04:06 -0300
Subject: [PATCH 3/4] fix(q6a): build FAT/squashfs/overlayfs/USB path into the
 kernel

---
 .../q6a/kernel-defconfig-fragment.config       | 18 ++++++++++++++++++
 configs/recalbox-q6a_defconfig                 |  1 +
 2 files changed, 19 insertions(+)
 create mode 100644 board/recalbox/qualcomm/q6a/kernel-defconfig-fragment.config

diff --git a/board/recalbox/qualcomm/q6a/kernel-defconfig-fragment.config b/board/recalbox/qualcomm/q6a/kernel-defconfig-fragment.config
new file mode 100644
index 0000000..99d941d
--- /dev/null
+++ b/board/recalbox/qualcomm/q6a/kernel-defconfig-fragment.config
@@ -0,0 +1,18 @@
+# Recalbox boots through an initramfs that must mount FAT (boot) + squashfs (rootfs) + overlayfs
+# before any module is available, and may boot from USB: everything on that path is built in.
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_SQUASHFS_LZO=y
+CONFIG_OVERLAY_FS=y
+CONFIG_FAT_FS=y
+CONFIG_VFAT_FS=y
+CONFIG_NLS_CODEPAGE_437=y
+CONFIG_NLS_ISO8859_1=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_UAS=y
+CONFIG_USB_DWC3_QCOM=y
+CONFIG_TYPEC_QCOM_PMIC=y
+CONFIG_TYPEC_UCSI=y
+CONFIG_UCSI_PMIC_GLINK=y
+CONFIG_INPUT_JOYDEV=y
+CONFIG_INPUT_UINPUT=y
diff --git a/configs/recalbox-q6a_defconfig b/configs/recalbox-q6a_defconfig
index be0430d..a6af6dd 100644
--- a/configs/recalbox-q6a_defconfig
+++ b/configs/recalbox-q6a_defconfig
@@ -382,6 +382,7 @@ BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.9"
 BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RECALBOX_PATH)/board/recalbox/qualcomm/q6a/kernel_patches"
 BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
 BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RECALBOX_PATH)/board/recalbox/qualcomm/q6a/kernel-defconfig.config"
+BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RECALBOX_PATH)/board/recalbox/qualcomm/q6a/kernel-defconfig-fragment.config"
 BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
 BR2_LINUX_KERNEL_DTS_SUPPORT=y
 BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/qcs6490-radxa-dragon-q6a"
-- 
2.53.0

